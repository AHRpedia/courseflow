{
  "name": "courseflow",
  "version": "1.0.0",
  "description": "Advanced offline video course manager for Windows with intelligent scanning, multi-language support, and rich media player",
  "main": "dist/main.js",
  "homepage": "./",
  "author": "Courseflow",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-build": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win --publish never",
    "build:portable": "npm run build && electron-builder -c.win.target=portable --win --publish never",
    "build:nsis": "npm run build && electron-builder -c.win.target=nsis --win --publish never",
    "dist": "npm run build && electron-builder --win",
    "publish": "npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-squirrel-startup": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "@tanstack/react-query": "^5.59.5",
    "framer-motion": "^11.11.10",
    "lucide-react": "^0.449.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^37.0.0",
    "electron-builder": "^25.1.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.5",
    "wait-on": "^8.0.2"
  }
}
